# Salin jadi `.env`. Jangan commit `.env`.

# ===== Model / Hugging Face =====
# Addon speaker butuh accept agreement:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
# WHISPER_HF_MODEL=maleo-ai/whisper-large-v3-turbo-id
# WHISPER_HF_SUBDIR=ct2-int8
# FFMPEG_PATH=
# FORCE_CPU=1

# ===== Web portal =====
# Wajib: string acak min. 32 karakter, mis. hasil: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# :80 = HTTP biasa via IP server. Isi domain (mis. stt.virtualfri.id) untuk HTTPS otomatis, lalu COOKIE_SECURE=1
PUBLIC_HOST=:80
COOKIE_SECURE=0
DISPLAY_TZ=Asia/Jakarta

# Admin default (dibuat sekali saat start pertama, wajib ganti password saat login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost

# ===== Database (container db) =====
# DATABASE_URL dirakit otomatis oleh docker-compose dari nilai di bawah.
# Pakai password tanpa karakter @ : / ? # agar URL valid.
# Tanpa Docker (tes lokal) portal memakai SQLite di data/portal.db.
POSTGRES_USER=stt
POSTGRES_PASSWORD=
POSTGRES_DB=stt

# ===== Antrian job =====
# 1 worker = 1 job sekaligus. Tambah kapasitas dengan menambah replika worker (GPU lain).
MAX_QUEUED_PER_USER=3
JOB_TIMEOUT_MIN=180
MAX_UPLOAD_MB=1024
DEFAULT_QUOTA_MB=10240

# ===== FRI Mini CDN =====
CDN_BASE_URL=https://cdn-fri.virtualfri.id
CDN_API_KEY=
CDN_API_SECRET=
