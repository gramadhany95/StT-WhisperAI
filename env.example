# Salin jadi `.env` (run.bat melakukannya otomatis). Jangan commit `.env`.

# Addon speaker (WhisperX diarization) — wajib jika addon dipakai.
# 1. Buat token: https://huggingface.co/settings/tokens
# 2. Accept agreement: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Opsional
# WHISPER_HF_MODEL=maleo-ai/whisper-large-v3-turbo-id
# WHISPER_HF_SUBDIR=ct2-int8
# WHISPER_MODEL_PATH=
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FORCE_CPU=1
